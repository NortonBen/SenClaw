{
  "id": "mini-browser",
  "name": "SenClaw Browser",
  "description": "A real, stealth web browser embedded as an App Space. It drives a live Chromium (via CDP) with an anti-detection layer, so pages don't flag it as automated. The user browses in a live view — address bar, tabs, click/scroll/type — while the AI shares the exact same session: it can navigate, read and extract page content, and autonomously complete multi-step tasks (search, fill forms, click flows) with human-like input, indistinguishable from a person. An ✨ AI side panel offers page-grounded chat and an Act ▶ agent. Powered by SenClaw's configured LLM.",
  "icon": "🕶️",
  "runtime": {
    "kind": "server",
    "start": "./mini-browser",
    "healthPath": "/api/status",
    "port": 4360
  },
  "integration": {
    "type": "iframe",
    "url": "/"
  },
  "bridge": {
    "postMessage": true,
    "capabilities": [
      "space.rest",
      "llm.request"
    ]
  },
  "mcp": {
    "name": "mini-browser-mcp",
    "transport": "http",
    "path": "/api/mcp/sse",
    "description": "SenClaw Browser MCP: drive a real stealth Chromium — navigate, snapshot the DOM, click/type/scroll/press with human-like input, manage tabs, extract text/links, run JS, and autonomously pursue a natural-language goal on the live page (browser_act) or answer questions about it (browser_extract).",
    "autoRegister": true
  },
