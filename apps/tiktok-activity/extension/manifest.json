{
  "manifest_version": 3,
  "name": "TikTok Activity Controller",
  "version": "1.0.0",
  "description": "Điều khiển một tab TikTok đã đăng nhập cho app tiktok-activity (SenClaw) qua WebSocket + chrome.debugger.",
  "permissions": ["debugger", "tabs", "storage", "scripting"],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "TikTok Activity" },
  "options_page": "panel.html"
}
