{
  "name": "TikTok: Tab Users — trong #grid-main, mở profile user đầu",
  "atomics": [
    {
      "id": "atom_wait_ui_after_follow",
      "name": "Chờ UI cập nhật (trong #grid-main)",
      "kind": "wait_ms",
      "params": {
        "ms": "1500"
      }
    },
    {
      "id": "atom_click_open_profile",
      "name": "Vào profile user đầu — chỉ trong #grid-main (avatar / nickname / link)",
      "kind": "click",
      "params": {
        "selectors": "#grid-main a.link-a11y-focus[href^=\"/@\"] img\n#grid-main span[data-e2e=\"search-user-unique-id-nickname\"]\n#grid-main a.link-a11y-focus[href^=\"/@\"]:not(:has(button[data-e2e=\"follow-back\"]))\n#grid-main a.link-a11y-focus[href^=\"/@\"]",
        "timeout_ms": "35000",
        "click_timeout_ms": "15000"
      }
    },
    {
      "id": "atom_wait_profile_load",
      "name": "Chờ trang profile load",
      "kind": "wait_load",
      "params": {
        "state": "load",
        "timeout_ms": "60000"
      }
    }
  ]
}
