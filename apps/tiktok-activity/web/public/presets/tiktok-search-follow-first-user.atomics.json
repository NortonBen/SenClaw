{
  "name": "TikTok: Search → Follow user đầu (tab Users)",
  "atomics": [
    {
      "id": "atom_wait_load",
      "name": "Chờ document load (trong step)",
      "kind": "wait_load",
      "params": {
        "state": "load",
        "timeout_ms": "60000"
      }
    },
    {
      "id": "atom_wait_ui",
      "name": "Chờ UI kết quả Users ổn định",
      "kind": "wait_ms",
      "params": {
        "ms": "1500"
      }
    },
    {
      "id": "atom_follow_if_needed",
      "name": "Follow user đầu nếu chưa follow (bỏ qua nếu đang follow / Bạn bè / Following)",
      "kind": "click_unless_contains",
      "params": {
        "selectors": "a.link-a11y-focus[href^=\"/@\"] button[data-testid=\"tux-web-button\"]\na.link-a11y-focus[href^=\"/@\"] button[data-e2e=\"follow-back\"]\nbutton[data-e2e=\"follow-back\"]\nbutton[data-testid=\"tux-web-button\"][data-e2e=\"follow-back\"]",
        "unless_substrings": "bạn bè\nđang follow\nfollowing\nfriends",
        "timeout_ms": "35000",
        "click_timeout_ms": "15000"
      }
    }
  ]
}
