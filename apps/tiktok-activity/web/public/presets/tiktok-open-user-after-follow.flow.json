{
  "name": "TikTok: Tab Users — trong #grid-main: follow nếu cần, rồi mở User",
  "actions": [
    {
      "id": "step_start",
      "type": "start",
      "name": "Start",
      "timeoutSeconds": 0,
      "config": {
        "_stage": "1"
      }
    },
    {
      "id": "step_follow_then_open_profile",
      "type": "playwright_atomics",
      "name": "Trong #grid-main: follow nếu cần, rồi mở profile user đầu",
      "timeoutSeconds": 120,
      "config": {
        "_stage": "1"
      },
      "atomics": [
        {
          "id": "atom_wait_ui",
          "name": "Chờ UI kết quả Users (#grid-main)",
          "kind": "wait_ms",
          "params": {
            "ms": "1500"
          }
        },
        {
          "id": "atom_follow_if_needed",
          "name": "Follow user đầu trong #grid-main nếu chưa follow",
          "kind": "click_unless_contains",
          "params": {
            "selectors": "#grid-main a.link-a11y-focus[href^=\"/@\"] button[data-testid=\"tux-web-button\"]\n#grid-main a.link-a11y-focus[href^=\"/@\"] button[data-e2e=\"follow-back\"]\n#grid-main button[data-e2e=\"follow-back\"]\n#grid-main button[data-testid=\"tux-web-button\"][data-e2e=\"follow-back\"]",
            "unless_substrings": "bạn bè\nđang follow\nfollowing\nfriends",
            "timeout_ms": "35000",
            "click_timeout_ms": "15000"
          }
        },
        {
          "id": "atom_wait_after_follow",
          "name": "Chờ UI sau follow",
          "kind": "wait_ms",
          "params": {
            "ms": "1200"
          }
        },
        {
          "id": "atom_click_open_profile",
          "name": "Vào profile đầu trong #grid-main",
          "kind": "click",
          "params": {
            "selectors": "#grid-main a.link-a11y-focus[href^=\"/@\"] img\n#grid-main span[data-e2e=\"search-user-unique-id-nickname\"]\n#grid-main a.link-a11y-focus[href^=\"/@\"]:not(:has(button[data-e2e=\"follow-back\"]))\n#grid-main a.link-a11y-focus[href^=\"/@\"]",
            "timeout_ms": "35000",
            "click_timeout_ms": "15000"
          }
        },
        {
          "id": "atom_wait_profile_load",
          "name": "Chờ trang profile load",
          "kind": "wait_load",
          "params": {
            "state": "load",
            "timeout_ms": "60000"
          }
        }
      ]
    }
  ]
}
