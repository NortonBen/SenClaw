{
  "name": "TikTok: Search → Follow user đầu (tab Users)",
  "actions": [
    {
      "id": "step_start",
      "type": "start",
      "name": "Start",
      "timeoutSeconds": 0,
      "config": {
        "_stage": "1"
      }
    },
    {
      "id": "step_search",
      "type": "search",
      "name": "Search (sửa query trong config)",
      "timeoutSeconds": 120,
      "config": {
        "_stage": "1",
        "query": "thay_bang_tu_khoa"
      }
    },
    {
      "id": "step_wait_page",
      "type": "wait_page_ready",
      "name": "Chờ trang search ổn định",
      "timeoutSeconds": 90,
      "config": {
        "_stage": "1",
        "state": "load",
        "timeout_ms": "60000"
      }
    },
    {
      "id": "step_follow_first_user",
      "type": "playwright_atomics",
      "name": "Follow user đầu (card Users — data-e2e follow-back)",
      "timeoutSeconds": 120,
      "config": {
        "_stage": "1"
      },
      "atomics": [
        {
          "id": "atom_wait_load",
          "name": "Chờ document load (trong step)",
          "kind": "wait_load",
          "params": {
            "state": "load",
            "timeout_ms": "60000"
          }
        },
        {
          "id": "atom_wait_ui",
          "name": "Chờ UI kết quả Users ổn định",
          "kind": "wait_ms",
          "params": {
            "ms": "1500"
          }
        },
        {
          "id": "atom_click_follow",
          "name": "Click Follow user đầu (nút follow-back)",
          "kind": "click",
          "params": {
            "selectors": "a.link-a11y-focus[href^=\"/@\"] button[data-e2e=\"follow-back\"]\nbutton[data-e2e=\"follow-back\"]\nbutton[data-testid=\"tux-web-button\"][data-e2e=\"follow-back\"]",
            "timeout_ms": "35000",
            "click_timeout_ms": "15000"
          }
        }
      ]
    }
  ]
}
