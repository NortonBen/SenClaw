{
  "manifest_version": 3,
  "name": "YouTube — SenClaw",
  "version": "0.1.0",
  "description": "Cầu nối giữa SenClaw YouTube app và phiên đăng nhập YouTube của bạn — bắt trạng thái đăng nhập, ký SAPISIDHASH và proxy các call InnerTube same-origin để không bị chặn.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "cookies",
    "webRequest",
    "scripting",
    "declarativeNetRequest",
    "debugger"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yt_origin_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube — SenClaw"
  }
}
